@model List<StudentManagement.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">RECORDS</div>
        <h1>Student Directory</h1>
        <p>View and manage registered students and their academic results.</p>
    </div>

    <a class="btn btn-primary"
       asp-controller="Home"
       asp-action="CreateStudent">
        + Add Student
    </a>
</div>

<section class="panel">
    <div class="toolbar">
        <div>
            <strong>All Students</strong>
            <div class="form-help">Student records retrieved from your database</div>
        </div>

        <div class="toolbar-actions">
            <a class="btn btn-outline"
               asp-controller="Home"
               asp-action="Students">
                Refresh List
            </a>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>Course</th>
                    <th>Score</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <strong>No students found</strong>
                                <p>Add your first student to populate this directory.</p>
                                <a class="btn btn-primary"
                                   asp-controller="Home"
                                   asp-action="CreateStudent">
                                    Add Student
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>
                                <div class="student-name">
                                    <div class="student-avatar">
                                        @(string.IsNullOrWhiteSpace(student.Name)
                                            ? "?"
                                            : student.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <strong>@student.Name</strong>
                                        <span>Student record</span>
                                    </div>

                                </div>
                            </td>
                            <td>@student.Course</td>
                            <td>@student.Score</td>
                            <td>
                                @if (student.Score >= 50)
                                {
                                    <span class="badge-status badge-pass">Pass</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-fail">Fail</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Home"
                                   asp-action="EditStudent"
                                   asp-route-id="@student.Id"
                                   class="btn btn-outline btn-sm">
                                    Edit
                                </a>
                            </td>
                            <td>
                                <form asp-controller="Home"
                                      asp-action="DeleteStudent"
                                      asp-route-id="@student.Id"
                                      method="post"
                                      style="display: inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this student?');">

                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
