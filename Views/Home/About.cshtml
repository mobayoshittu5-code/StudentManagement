@{
    ViewData["Title"] = "About";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">ABOUT THE SYSTEM</div>
        <h1>About StudentHub</h1>
        <p>A simple and organized platform for managing student academic records.</p>
    </div>
</div>

<section class="panel">
    <div class="panel-body">
        <div class="about-intro">
            <div class="about-icon">
                S
            </div>

            <div>
                <h2>Student Management System</h2>
                <p>
                    StudentHub is a Student Management System designed to make
                    storing, viewing, and managing student academic information
                    simple and organized.
                </p>

                <p>
                    The application provides a central place where administrators
                    can manage student records, monitor academic results, and
                    maintain accurate student information.
                </p>
            </div>
        </div>
    </div>
</section>

<div class="about-grid">

    <section class="panel">
        <div class="panel-body">
            <div class="about-card-icon">
                S
            </div>

            <h3>Student Records</h3>

            <p>
                Store important student information such as names, courses,
                scores, and academic results in a structured system.
            </p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="about-card-icon">
                A
            </div>

            <h3>Academic Management</h3>

            <p>
                Monitor student performance and easily identify academic
                results using organized records and result statuses.
            </p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="about-card-icon">
                D
            </div>

            <h3>Database Driven</h3>

            <p>
                Student information can be stored persistently using
                ASP.NET Core, Entity Framework Core, and SQL Server.
            </p>
        </div>
    </section>

</div>

<section class="panel about-purpose">
    <div class="panel-body">
        <div class="eyebrow">PROJECT PURPOSE</div>

        <h2>Built for simplicity and growth</h2>

        <p>
            StudentHub is designed with a clean and straightforward interface
            so that student information can be managed efficiently.
        </p>

        <p>
            The system can be expanded over time with features such as
            authentication, student editing, deletion, search, filtering,
            reporting, and role-based access control.
        </p>

        <a class="btn btn-primary"
           asp-controller="Home"
           asp-action="Students">
            View Students
        </a>
    </div>
</section>
